# Client (Vite) — safe to expose in the browser, already had these in v7
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── NEW in v8 — Vercel serverless functions only (api/*.js) ──────────
# Set these in Vercel: Project → Settings → Environment Variables.
# They are NEVER read by client code and must NOT be prefixed with
# VITE_ (that prefix is what tells Vite to ship a var to the browser).

# Same Supabase project as above, but the SERVICE ROLE key this time —
# find it at Supabase → Project Settings → API → service_role (secret).
# Server-side (Vercel Serverless Functions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=Spandan 2026 <onboarding@resend.dev>
